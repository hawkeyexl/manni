# A house rule with an ontology header, so its findings carry the file's own
# id and guide (proposal 0089).
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix graph: <https://hawkeyexl.github.io/manni/graph/ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix house: <https://example.com/house/shapes#> .

<https://example.com/house/shapes>
  a owl:Ontology ;
  dcterms:identifier "house:shapes:1.0.0" ;
  rdfs:seeAlso <https://example.com/house/guide/> .

house:DescribedShape
  a sh:NodeShape ;
  sh:targetClass graph:Document ;
  sh:description "A page the house style describes." ;
  sh:property house:Described-description .

house:Described-description
  a sh:PropertyShape ;
  sh:path dcterms:description ;
  sh:name "description" ;
  sh:minCount 1 ;
  sh:maxCount 1 ;
  sh:severity sh:Warning ;
  sh:description "Every page carries a one-sentence description." ;
  sh:message "Add a `description` that says what the page is for." .
