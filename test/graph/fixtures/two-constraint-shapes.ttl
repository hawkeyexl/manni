# One property shape with two constraints and no sh:message of its own. A value
# that breaks both yields two results on the same shape, node and path, each
# with the library's own message, so the merge must say both, once each.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <https://example.com/two#> .

ex:ThingShape a sh:NodeShape ;
    sh:targetClass ex:Thing ;
    sh:property [
        sh:path ex:code ;
        sh:pattern "^[a-z]+$" ;
        sh:maxLength 2 ;
    ] .
