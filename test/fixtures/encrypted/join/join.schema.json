{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["title", "owner", "jira"],
  "properties": {
    "title": { "type": "string" },
    "owner": {
      "type": "string",
      "enum": ["platform", "billing"],
      "x-manni-encrypt": true
    },
    "jira": { "type": "string", "pattern": "^PLAT-[0-9]+$" }
  }
}
