{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["title", "id", "jira"],
  "properties": {
    "title": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "source": { "type": "string" },
    "jira": { "type": "string", "pattern": "^PLAT-[0-9]+$" }
  }
}
