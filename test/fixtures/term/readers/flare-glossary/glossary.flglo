    IgnoreCase="false"
    conditions="Default.PrintOnly">
    <Terms>
      <Term>Print margin</Term>
    </Terms>
    <Definition
      Link="">The white space around a printed page.</Definition>
  </GlossaryEntry>
  <GlossaryEntry
    glossTerm="Glossary.Term4"
