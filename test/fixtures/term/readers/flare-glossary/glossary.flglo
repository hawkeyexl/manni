<CatapultGlossary>
  <GlossaryEntry
    glossTerm="Glossary.Term0"
    TermClass="Popup"
    Stem=""
    IgnoreCase="false">
    <Terms>
      <Term>CDC</Term>
      <Term>Change data capture</Term>
    </Terms>
    <Definition
      Link="">Captures each change made to a database.</Definition>
  </GlossaryEntry>
  <GlossaryEntry>
    <Terms>
      <Term>Object manager</Term>
    </Terms>
    <Definition>A tool that views and edits a database.</Definition>
  </GlossaryEntry>
  <!-- A topic definition. The text is left in to prove the link wins over it. -->
  <GlossaryEntry
    glossTerm="Glossary.Term2"
