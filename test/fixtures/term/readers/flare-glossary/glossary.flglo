    Stem=""
    IgnoreCase="false">
    <Terms>
      <Term>Replication</Term>
    </Terms>
    <Definition
      Link="/Content/Topics/Replication.htm">Copies data between servers.</Definition>
  </GlossaryEntry>
  <GlossaryEntry
    glossTerm="Glossary.Term3"
