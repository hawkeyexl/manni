<martif type="TBX" xml:lang="en-US">
  <martifHeader>
    <fileDesc>
      <sourceDesc>
        <p>A hand-written sample in the shape of a product terminology export.</p>
      </sourceDesc>
    </fileDesc>
  </martifHeader>
  <text>
    <body>
      <termEntry id="100">
        <langSet xml:lang="en-US">
          <descripGrp>
            <descrip type="definition">To keep a file on disk.</descrip>
