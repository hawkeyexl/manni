          <ntig>
            <termGrp>
              <term>save</term>
              <termNote type="partOfSpeech">Verb</termNote>
            </termGrp>
          </ntig>
        </langSet>
        <langSet xml:lang="de-DE">
          <ntig>
            <termGrp>
              <term>speichern</term>
              <termNote type="partOfSpeech">Verb</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="100">
        <langSet xml:lang="en-US">
          <ntig>
            <termGrp>
              <term>save as</term>
              <termNote type="partOfSpeech">Verb</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry>
        <langSet xml:lang="en-US">
          <ntig>
            <termGrp>
              <term>Open File</term>
              <termNote type="partOfSpeech">Noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
        <langSet xml:lang="de-DE">
          <ntig>
            <termGrp>
              <term>Datei öffnen</term>
              <termNote type="partOfSpeech">Noun</termNote>
            </termGrp>
