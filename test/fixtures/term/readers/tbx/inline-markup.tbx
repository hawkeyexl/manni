<?xml version="1.0" encoding="UTF-8"?>
<martif type="TBX" xml:lang="en">
  <martifHeader>
    <fileDesc>
      <sourceDesc>
        <p>Values that carry inline markup.</p>
      </sourceDesc>
    </fileDesc>
  </martifHeader>
  <text>
    <body>
      <termEntry id="water">
        <descrip type="definition">The compound <hi type="italics">dihydrogen monoxide</hi>, known in German as <foreign xml:lang="de">Wasser</foreign>.</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>H<hi type="subscript">2</hi>O</term>
            <termNote type="administrativeStatus">preferredTerm-admn-sts</termNote>
            <descrip type="context">Pour the <bpt i="1">&lt;b&gt;</bpt>water<ept i="1">&lt;/b&gt;</ept> slowly.</descrip>
            <descrip type="context">Boil the water first.<!-- reviewed --></descrip>
            <note>Formula <ph>&lt;br/&gt;</ph> &amp; name.</note>
          </tig>
          <tig>
            <term>water</term>
            <termNote type="administrativeStatus">admittedTerm-admn-sts</termNote>
          </tig>
        </langSet>
      </termEntry>
    </body>
  </text>
</martif>
