@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix dcterms: <http://purl.org/dc/terms/>.

<> a skos:ConceptScheme;
    dcterms:description "Generated by manni term write.";
    skos:hasTopConcept <#spectacle-lens>, <#kubernetes>, <#api>, <#cpp>, <#gleitsichtglas>.
<#progressive-lens> a skos:Concept;
    skos:inScheme <>;
    skos:prefLabel "progressive lens";
    skos:altLabel "PAL", "graduated lens";
    skos:hiddenLabel "no-line bifocal";
    skos:definition "A spectacle lens whose power changes gradually, with no visible line.";
    skos:scopeNote "Eyewear only, not camera optics.";
    skos:broader <#spectacle-lens>.
<#spectacle-lens> a skos:Concept;
    skos:inScheme <>;
    skos:topConceptOf <>;
    skos:prefLabel "spectacle lens";
    skos:definition "A lens worn in front of the eye to correct vision.";
    skos:narrower <#progressive-lens>.
<#kubernetes> a skos:Concept;
    skos:inScheme <>;
    skos:topConceptOf <>;
    skos:prefLabel "Kubernetes";
    skos:altLabel "K8s";
    skos:hiddenLabel "Kubernates";
    skos:definition "An orchestrator for \"containers\", services, and jobs.".
<#api> a skos:Concept;
    skos:inScheme <>;
    skos:topConceptOf <>;
    skos:prefLabel "API";
    skos:altLabel "application programming interface";
    skos:definition "A contract <between> programs & their callers.".
<#cpp> a skos:Concept;
    skos:inScheme <>;
    skos:topConceptOf <>;
    skos:prefLabel "C++";
    skos:altLabel "CPP";
    skos:definition "A compiled programming language.";
    skos:related <#api>.
<#gleitsichtglas> a skos:Concept;
    skos:inScheme <>;
    skos:topConceptOf <>;
    skos:prefLabel "Gleitsichtglas"@de;
    skos:altLabel "Gleitsichtbrille"@de;
    skos:definition "Ein Brillenglas, dessen Stärke stufenlos zunimmt."@de.
