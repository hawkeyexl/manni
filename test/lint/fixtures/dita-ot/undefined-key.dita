<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<!-- One defect: "revoking" is defined by no keydef in keys.ditamap. -->
<task id="undefined-key">
  <title>Rotate an API key</title>
  <shortdesc>Replace a live secret without interrupting traffic.</shortdesc>
  <taskbody>
    <steps>
      <step><cmd>Create a replacement key.</cmd></step>
      <step><cmd>Follow <xref keyref="revoking"/> to retire the old one.</cmd></step>
    </steps>
  </taskbody>
</task>
