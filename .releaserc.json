{
  "branches": [
    "main",
    { "name": "next", "channel": "next", "prerelease": "next" },
    {
      "name": "feat/**",
      "channel": "${name.replace(/^feat\\//, '').replace(/[^a-zA-Z0-9-]/g, '-').toLowerCase()}",
      "prerelease": "${name.replace(/^feat\\//, '').replace(/[^a-zA-Z0-9-]/g, '-').toLowerCase()}"
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [{ "type": "perf", "release": false }]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\n`manni` continues the history of `docmeta`, which it was published as up to\n4.13.1. Entries below that version are docmeta releases; the repository\nhistory is the same one."
      }
    ],
    "@semantic-release/npm",
    "./scripts/release-sync-versions.mjs",
    "./scripts/release-cite-update.mjs",
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "site.metadata.yaml",
          "package.json",
          "package-lock.json",
          "README.md",
          "examples/**",
          "docs/src/content/docs/**/*.md",
          "docs/src/content/docs/**/*.mdx"
        ],
        "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successCommentCondition": false
      }
    ]
  ]
}
