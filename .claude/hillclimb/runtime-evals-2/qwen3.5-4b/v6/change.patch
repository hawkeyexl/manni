+/** At most this many events per condition, so one busy turn cannot crowd the item. */
+const MATCHED_EVENTS = 10;
+const VERB = { read: "read", write: "wrote", edit: "edited" } as const;
+
+/**
+ * What in the window met an armed rule's `when`, one line per event, and
+ * empty for a rule with none. The gate already decided the rule applies; this
+ * says on what, so a read that armed a file trigger is not taken for a change
+ * to the file. Paths and commands pass through the judge's redactor.
+ * `turn-count-above` names no event, so it adds no line.
+ */
+export function triggerMatches(
+  when: Record<string, unknown> | undefined,
+  window: TraceWindow,
+  opts: { cwd: string; root: string; redact: readonly string[] },
+): string[] {
+  if (when === undefined) return [];
+  const scrub = makeRedactor(opts.redact);
+  const first = (items: string[]): string[] => [...new Set(items)].slice(0, MATCHED_EVENTS);
+  const clip = (s: string): string => clipTo(scrub(s.replace(/\s+/g, " ").trim()), COMMAND_CHARS);
+  const lines: string[] = [];
+  const glob = when["file-access"];
+  if (typeof glob === "string") {
+    const hits = window.fileAccesses.filter((a) => matchesGlob(a.path, glob));
+    lines.push(...first(hits.map((a) => `${VERB[a.op]} ${scrub(projectPath(a.path, opts.cwd, opts.root))}`)));
+    if (hits.length > 0 && hits.every((a) => a.op === "read")) {
+      lines.push(`wrote or edited no file matching \`${glob}\``);
+    }
+  }
+  const tool = when["tool-used"];
+  if (typeof tool === "string") {
+    const n = window.toolCalls.filter((c) => c.name === tool).length;
+    if (n > 0) lines.push(`used ${tool} ${n === 1 ? "once" : `${String(n)} times`}`);
+  }
+  const prompt = when["prompt-matches"];
+  if (typeof prompt === "string") {
+    const re = new RegExp(prompt);
+    lines.push(...first(window.userMessages.filter((t) => re.test(t)).map((t) => `the prompt "${clip(t)}"`)));
+  }
+  const command = when["command-matches"];
+  if (typeof command === "string") {
+    const re = new RegExp(command);
+    lines.push(
+      ...first(
+        window.toolCalls.flatMap((c) =>
+          c.name === "Bash" && typeof c.input.command === "string" && re.test(c.input.command)
+            ? [`ran \`${clip(c.input.command)}\``]
+            : [],
+        ),
+      ),
+    );
+  }
+  return lines;
+}
