node_modules/
dist/
.husky/_/
*.log
.DS_Store
coverage/
.vitest/

# Doc Detective generated output. The tests live inline in docs/ (.mdx) and the
# config is .doc-detective.json at the repo root; this directory is run output only.
.doc-detective/

# `docmeta fill` proposal cache — machine-local, safe to delete at any time.
.docmeta/
# The family cache directory: `.manni/meta/…` for the metadata tool,
# `.manni/kg/…` for the graph tool's proposal and vector caches. Same rule.
.manni/

# Scratch output. The kg packaged test (test/kg/integration/packaged.test.ts)
# extracts the `npm pack` tarball here so Node resolves its dependencies from
# this repo's node_modules.
.tmp/

# Derived, binary, and not CI-regenerable (model weights are a download).
# `manni kg embed` writes one vector sidecar per language into the configured
# `embed.out` directory, `kg/` by default. The goldens under
# test/kg/fixtures/golden/ are mock-embedded and committed deliberately, and
# are not under a `kg/` directory.
**/kg/vectors.*.bin

# Feature demo videos (see CLAUDE.md). Generated per feature, handed to the
# user or attached to the PR — never committed, since binaries bloat history.
media/

# Baseline written by the Doc Detective steps in set-up/new-required-field.mdx.
# Run output, not a source file.
.dd-baseline.json

# Vale styles are fetched by `vale sync`, not committed
.vale/styles/
