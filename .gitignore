node_modules/
dist/
.husky/_/
*.log
.DS_Store
coverage/
.vitest/

# Doc Detective generated output. The tests live inline in docs/ (.mdx) and the
# config is .doc-detective.json at the repo root; this directory is run output only.
.doc-detective/

# `docmeta fill` proposal cache — machine-local, safe to delete at any time.
.docmeta/
# The family cache directory: `.manni/meta/…` for the metadata tool,
# `.manni/graph/…` for the graph tool's proposal and vector caches. Same rule.
.manni/

# Scratch output. The graph packaged test (test/graph/integration/packaged.test.ts)
# extracts the `npm pack` tarball here so Node resolves its dependencies from
# this repo's node_modules.
.tmp/

# Derived, binary, and not CI-regenerable (model weights are a download).
# `manni graph embed` writes one vector sidecar per language into the configured
# `embed.out` directory, `graph/` by default. The goldens under
# test/graph/fixtures/golden/ are mock-embedded and committed deliberately, and
# sit directly under `golden/`, which the pattern does not match.
**/graph/vectors.*.bin

# Feature demo videos (see CLAUDE.md). The sources, scripts, captions, GIFs
# and thumbnails under media/ are committed; the rendered MP4s are not, and
# neither are the Remotion install or the scratch demo repos, which carry
# their own .git and can only be recorded as empty embedded-repo pointers.
media/**/*.mp4
media/remotion/node_modules/
media/scratch-*/

# Baseline written by the Doc Detective steps in set-up/new-required-field.mdx.
# Run output, not a source file.
.dd-baseline.json

# Vale styles are fetched by `vale sync`, not committed. The one exception is
# Terms/, which `manni term write -f vale` generates from the docs glossary.
# The Vale workflow runs no Node build to generate it, so it is committed, and
# the Docs workflow fails when it no longer matches the glossary.
.vale/styles/*
!.vale/styles/Terms/
