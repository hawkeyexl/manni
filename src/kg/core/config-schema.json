{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dockg:config:0.1",
  "title": "dockg configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {
      "const": 1
    },
    "baseIri": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "out": {
      "type": "string",
      "minLength": 1
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["root"],
        "properties": {
          "basePath": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "extensions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\."
            }
          },
          "language": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(-[A-Za-z]{4})?(-([A-Za-z]{2}|[0-9]{3}))?(-([A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*$"
          },
          "indexFiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "derive": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "frontmatter",
              "sections",
              "links",
              "tags",
              "images",
              "code",
              "provenance"
            ]
          }
        }
      }
    },
    "validate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shapes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "auto"
            }
          ]
        },
        "qualified": {
          "type": "boolean"
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverageThreshold": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "description": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "creator": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "created": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "modified": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "subject": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "label": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "language": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "type": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "applies-to": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "about-product-lifecycle": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "about-product-aspect": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          ]
        }
      }
    },
    "fill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": ["anthropic", "openai", "claude-cli", "llama-cpp", "mock"]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "apiKeyEnv": {
          "type": "string",
          "minLength": 1
        },
        "baseUrl": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "maxCostUsd": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "cacheDir": {
          "type": "string",
          "minLength": 1
        },
        "minConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "writeProvenance": {
          "type": "boolean"
        },
        "validateGraph": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "label",
              "alt-labels",
              "broader",
              "narrower",
              "related-concepts",
              "concepts",
              "type",
              "applies-to",
              "about-product-lifecycle",
              "about-product-aspect",
              "not-applicable-to",
              "not-about-product-aspect"
            ]
          }
        },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputPerMTok", "outputPerMTok"],
          "properties": {
            "inputPerMTok": {
              "type": "number",
              "minimum": 0
            },
            "outputPerMTok": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "sections": {
          "type": "boolean"
        }
      }
    },
    "embed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "dtype": {
          "type": "string",
          "minLength": 1
        },
        "out": {
          "type": "string",
          "minLength": 1
        },
        "cacheDir": {
          "type": "string",
          "minLength": 1
        },
        "byLanguage": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z]{2,3}(-[A-Za-z]{4})?(-([A-Za-z]{2}|[0-9]{3}))?(-([A-Za-z0-9]{5,8}|[0-9][A-Za-z0-9]{3}))*$": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "dtype": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iirds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "creator": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "enum": ["1.2", "1.3"]
            }
          }
        }
      }
    }
  }
}
