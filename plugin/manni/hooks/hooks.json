{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no @hawkeyexl/manni tracevals capture",
            "timeout": 60,
            "statusMessage": "Recording the session manifest…"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --no @hawkeyexl/manni status",
            "timeout": 30,
            "statusMessage": "Reading what manni checks here…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no @hawkeyexl/manni check",
            "timeout": 120,
            "statusMessage": "Checking the edited file…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --no @hawkeyexl/manni check",
            "timeout": 600,
            "statusMessage": "Checking every file you changed…"
          }
        ]
      }
    ]
  }
}
