{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no @hawkeyexl/manni tracevals capture",
            "timeout": 60,
            "statusMessage": "Recording the session manifest…"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --no @hawkeyexl/manni status",
            "timeout": 30,
            "statusMessage": "Reading what manni checks here…"
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no @hawkeyexl/manni tracevals prepare",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx --no @hawkeyexl/manni check",
            "timeout": 120,
            "statusMessage": "Checking the edited file…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --no @hawkeyexl/manni check",
            "timeout": 600,
            "statusMessage": "Checking every file you changed…"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --no @hawkeyexl/manni check",
            "timeout": 600,
            "statusMessage": "Checking the subagent's turn against its rules…"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --no @hawkeyexl/manni tracevals release",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
